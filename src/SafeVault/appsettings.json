{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SafeVault": "Data Source=safevault.db"
  },
  "Jwt": {
    "Issuer": "SafeVault",
    "Audience": "SafeVault",
    "LifetimeMinutes": 30
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  }
}
